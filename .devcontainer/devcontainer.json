{
    "name": "vllm-dev",
    "build": {
      "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "charliermarsh.ruff",
          "eamodio.gitlens"
        ]
      }
    },
    "runArgs": [
      "--gpus",
      "all"
    ],
    "mounts": [
      "source=${localWorkspaceFolder}/.cache/docker_ccache,target=/root/.cache/ccache,type=bind"
        ],
    "postCreateCommand": "bash /tmp/setup.sh"
  }