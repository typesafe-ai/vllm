{
    "name": "vllm-dev",
    "build": {
      "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "charliermarsh.ruff",
          "eamodio.gitlens"
        ]
      }
    },
    "runArgs": [
      "--gpus",
      "all"
    ],
    "postCreateCommand": "bash /tmp/setup.sh"
  }